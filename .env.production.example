# ========================================================
# SpendLens Production Environment Configuration
# ========================================================

# Server Environment
NODE_ENV=production
PORT=3001

# Application URLs
FRONTEND_URL=https://your-frontend-domain.com
GOOGLE_REDIRECT_URI=https://your-backend-domain.com/auth/google/callback

# PostgreSQL Database (Neon pooled connection string)
# Note: Use the pooler host (-pooler) with sslmode=require
DATABASE_URL=postgresql://user:password@ep-lucky-moon-xxxx-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require

# Security Keys (Generate strong 64-character random strings)
# Command to generate: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_at_least_64_characters_long
TOKEN_ENCRYPTION_KEY=your_64_character_hex_string_for_aes_256_gcm_token_encryption

# Google OAuth 2.0 Credentials (From GCP Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Anthropic Claude API (Optional for fallback receipt intelligence)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Redis URL (Optional - in-memory fallback enabled if not set)
REDIS_URL=redis://default:password@your-redis-host:6379
