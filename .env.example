# Gmail Expense Analyzer (SpendLens)

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Frontend URL — backend redirects here after OAuth callback
# For production, set to your Vercel/deployed frontend URL
FRONTEND_URL=http://localhost:3000

# Claude API (for LLM batch fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Postgres (use DATABASE_URL for hosted Postgres like Neon)
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=expense_analyzer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=localhost:9092

# JWT Session
JWT_SECRET=your_jwt_secret_min_32_chars

# AES-256-GCM token encryption key — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=your_base64_encryption_key

# Backend
BACKEND_PORT=3001
NODE_ENV=development

# Frontend — used at build time by Vite
VITE_API_URL=http://localhost:3001
